{
  "openapi": "3.1.0",
  "info": {
    "title": "Case Management API",
    "description": "A modular, testable case management backend built with FastAPI and SQLite. Week 1 hands-on project for the FDE Fresher Readiness Program.",
    "version": "1.0.0"
  },
  "paths": {
    "/api/v1/cases": {
      "post": {
        "tags": [
          "Cases"
        ],
        "summary": "Create a new case",
        "description": "Create a new case with the provided details. The creator must be an existing user.",
        "operationId": "create_case_api_v1_cases_post",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseCreate"
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "get": {
        "tags": [
          "Cases"
        ],
        "summary": "List all cases",
        "description": "Retrieve a paginated list of cases with optional filters.",
        "operationId": "list_cases_api_v1_cases_get",
        "parameters": [
          {
            "name": "skip",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "minimum": 0,
              "description": "Number of records to skip",
              "default": 0,
              "title": "Skip"
            },
            "description": "Number of records to skip"
          },
          {
            "name": "limit",
            "in": "query",
            "required": false,
            "schema": {
              "type": "integer",
              "maximum": 500,
              "minimum": 1,
              "description": "Max records to return",
              "default": 100,
              "title": "Limit"
            },
            "description": "Max records to return"
          },
          {
            "name": "status",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/CaseStatus"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by status",
              "title": "Status"
            },
            "description": "Filter by status"
          },
          {
            "name": "priority",
            "in": "query",
            "required": false,
            "schema": {
              "anyOf": [
                {
                  "$ref": "#/components/schemas/CasePriority"
                },
                {
                  "type": "null"
                }
              ],
              "description": "Filter by priority",
              "title": "Priority"
            },
            "description": "Filter by priority"
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseListResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/cases/{case_id}": {
      "get": {
        "tags": [
          "Cases"
        ],
        "summary": "Retrieve a case by ID",
        "description": "Fetch a single case by its unique identifier.",
        "operationId": "get_case_api_v1_cases__case_id__get",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      },
      "put": {
        "tags": [
          "Cases"
        ],
        "summary": "Update a case",
        "description": "Update one or more fields of an existing case.",
        "operationId": "update_case_api_v1_cases__case_id__put",
        "parameters": [
          {
            "name": "case_id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "integer",
              "title": "Case Id"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/CaseUpdate"
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/CaseResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/api/v1/users": {
      "get": {
        "tags": [
          "Users"
        ],
        "summary": "List all users",
        "description": "List all users.",
        "operationId": "list_users_api_v1_users_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "items": {
                    "$ref": "#/components/schemas/UserResponse"
                  },
                  "type": "array",
                  "title": "Response List Users Api V1 Users Get"
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": [
          "Users"
        ],
        "summary": "Create a new user",
        "description": "Create a user who can create or be assigned cases.",
        "operationId": "create_user_api_v1_users_post",
        "requestBody": {
          "content": {
            "application/json": {
              "schema": {
                "$ref": "#/components/schemas/UserCreate"
              }
            }
          },
          "required": true
        },
        "responses": {
          "201": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/UserResponse"
                }
              }
            }
          },
          "422": {
            "description": "Validation Error",
            "content": {
              "application/json": {
                "schema": {
                  "$ref": "#/components/schemas/HTTPValidationError"
                }
              }
            }
          }
        }
      }
    },
    "/health": {
      "get": {
        "tags": [
          "System"
        ],
        "summary": "Health Check",
        "description": "Health check endpoint.\n\nUsed to verify the application is running.\nReturns a simple JSON response.",
        "operationId": "health_check_health_get",
        "responses": {
          "200": {
            "description": "Successful Response",
            "content": {
              "application/json": {
                "schema": {
                  "additionalProperties": true,
                  "type": "object",
                  "title": "Response Health Check Health Get"
                }
              }
            }
          }
        }
      }
    }
  },
  "components": {
    "schemas": {
      "CaseCreate": {
        "properties": {
          "title": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Title",
            "description": "Brief summary of the case",
            "examples": [
              "Login page returns 500 error"
            ]
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Detailed description of the case",
            "examples": [
              "Users clicking the login button on Chrome see a 500 error page."
            ]
          },
          "priority": {
            "$ref": "#/components/schemas/CasePriority",
            "description": "Priority level",
            "default": "MEDIUM"
          },
          "case_type": {
            "$ref": "#/components/schemas/CaseType",
            "description": "Type of case",
            "default": "INQUIRY"
          },
          "created_by": {
            "type": "integer",
            "exclusiveMinimum": 0.0,
            "title": "Created By",
            "description": "ID of the user creating the case"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To",
            "description": "ID of the user assigned to the case"
          }
        },
        "type": "object",
        "required": [
          "title",
          "created_by"
        ],
        "title": "CaseCreate",
        "description": "Schema for creating a new case (POST /cases request body).\n\nRequired fields: title, created_by\nOptional fields: description, priority, case_type, assigned_to\nFields NOT in request: id, status (defaults to OPEN), timestamps"
      },
      "CaseListResponse": {
        "properties": {
          "cases": {
            "items": {
              "$ref": "#/components/schemas/CaseResponse"
            },
            "type": "array",
            "title": "Cases"
          },
          "total": {
            "type": "integer",
            "title": "Total"
          }
        },
        "type": "object",
        "required": [
          "cases",
          "total"
        ],
        "title": "CaseListResponse",
        "description": "Response schema for listing multiple cases."
      },
      "CasePriority": {
        "type": "string",
        "enum": [
          "LOW",
          "MEDIUM",
          "HIGH",
          "CRITICAL"
        ],
        "title": "CasePriority",
        "description": "Priority levels for cases."
      },
      "CaseResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "title": {
            "type": "string",
            "title": "Title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string"
              },
              {
                "type": "null"
              }
            ],
            "title": "Description"
          },
          "status": {
            "$ref": "#/components/schemas/CaseStatus"
          },
          "priority": {
            "$ref": "#/components/schemas/CasePriority"
          },
          "case_type": {
            "$ref": "#/components/schemas/CaseType"
          },
          "created_by": {
            "type": "integer",
            "title": "Created By"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "integer"
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          },
          "updated_at": {
            "type": "string",
            "format": "date-time",
            "title": "Updated At"
          },
          "resolved_at": {
            "anyOf": [
              {
                "type": "string",
                "format": "date-time"
              },
              {
                "type": "null"
              }
            ],
            "title": "Resolved At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "title",
          "description",
          "status",
          "priority",
          "case_type",
          "created_by",
          "assigned_to",
          "created_at",
          "updated_at",
          "resolved_at"
        ],
        "title": "CaseResponse",
        "description": "Schema for a case in API responses.\n\nmodel_config with from_attributes=True tells Pydantic to read\ndata from SQLAlchemy model attributes (not just dicts)."
      },
      "CaseStatus": {
        "type": "string",
        "enum": [
          "OPEN",
          "IN_PROGRESS",
          "RESOLVED",
          "CLOSED"
        ],
        "title": "CaseStatus",
        "description": "Valid statuses a case can have."
      },
      "CaseType": {
        "type": "string",
        "enum": [
          "BUG",
          "FEATURE_REQUEST",
          "INQUIRY",
          "COMPLAINT"
        ],
        "title": "CaseType",
        "description": "Classification of the case."
      },
      "CaseUpdate": {
        "properties": {
          "title": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 255,
                "minLength": 1
              },
              {
                "type": "null"
              }
            ],
            "title": "Title",
            "description": "Updated title"
          },
          "description": {
            "anyOf": [
              {
                "type": "string",
                "maxLength": 5000
              },
              {
                "type": "null"
              }
            ],
            "title": "Description",
            "description": "Updated description"
          },
          "status": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseStatus"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated status"
          },
          "priority": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CasePriority"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated priority"
          },
          "case_type": {
            "anyOf": [
              {
                "$ref": "#/components/schemas/CaseType"
              },
              {
                "type": "null"
              }
            ],
            "description": "Updated type"
          },
          "assigned_to": {
            "anyOf": [
              {
                "type": "integer",
                "exclusiveMinimum": 0.0
              },
              {
                "type": "null"
              }
            ],
            "title": "Assigned To",
            "description": "Updated assignee user ID"
          }
        },
        "type": "object",
        "title": "CaseUpdate",
        "description": "Schema for updating a case (PUT /cases/{case_id} request body).\n\nAll fields are optional \u2014 only send what you want to change.\nThis is the \"partial update\" pattern (common in REST APIs)."
      },
      "HTTPValidationError": {
        "properties": {
          "detail": {
            "items": {
              "$ref": "#/components/schemas/ValidationError"
            },
            "type": "array",
            "title": "Detail"
          }
        },
        "type": "object",
        "title": "HTTPValidationError"
      },
      "UserCreate": {
        "properties": {
          "username": {
            "type": "string",
            "maxLength": 50,
            "minLength": 2,
            "title": "Username",
            "description": "Unique username",
            "examples": [
              "jdoe"
            ]
          },
          "email": {
            "type": "string",
            "maxLength": 255,
            "title": "Email",
            "description": "Email address",
            "examples": [
              "jdoe@example.com"
            ]
          },
          "full_name": {
            "type": "string",
            "maxLength": 255,
            "minLength": 1,
            "title": "Full Name",
            "description": "Full name",
            "examples": [
              "Jane Doe"
            ]
          },
          "role": {
            "type": "string",
            "maxLength": 50,
            "title": "Role",
            "description": "User role",
            "default": "analyst",
            "examples": [
              "analyst",
              "manager",
              "admin"
            ]
          }
        },
        "type": "object",
        "required": [
          "username",
          "email",
          "full_name"
        ],
        "title": "UserCreate",
        "description": "Schema for creating a new user."
      },
      "UserResponse": {
        "properties": {
          "id": {
            "type": "integer",
            "title": "Id"
          },
          "username": {
            "type": "string",
            "title": "Username"
          },
          "email": {
            "type": "string",
            "title": "Email"
          },
          "full_name": {
            "type": "string",
            "title": "Full Name"
          },
          "role": {
            "type": "string",
            "title": "Role"
          },
          "created_at": {
            "type": "string",
            "format": "date-time",
            "title": "Created At"
          }
        },
        "type": "object",
        "required": [
          "id",
          "username",
          "email",
          "full_name",
          "role",
          "created_at"
        ],
        "title": "UserResponse",
        "description": "Schema for user in API responses."
      },
      "ValidationError": {
        "properties": {
          "loc": {
            "items": {
              "anyOf": [
                {
                  "type": "string"
                },
                {
                  "type": "integer"
                }
              ]
            },
            "type": "array",
            "title": "Location"
          },
          "msg": {
            "type": "string",
            "title": "Message"
          },
          "type": {
            "type": "string",
            "title": "Error Type"
          },
          "input": {
            "title": "Input"
          },
          "ctx": {
            "type": "object",
            "title": "Context"
          }
        },
        "type": "object",
        "required": [
          "loc",
          "msg",
          "type"
        ],
        "title": "ValidationError"
      }
    }
  }
}