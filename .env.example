# Case Management Backend — Environment Configuration
# Copy this file to .env and fill in your values.
# NEVER commit the .env file to version control.

# Application
APP_NAME=case-management-backend
APP_VERSION=4.0.0
APP_ENV=development
APP_DEBUG=true
APP_HOST=127.0.0.1
APP_PORT=8000

# Database (SQLite)
# For SQLite, this is the path to the database file.
# A relative path is relative to the project root.
DATABASE_URL=sqlite:///./case_management.db

# Logging
LOG_LEVEL=DEBUG
LOG_FORMAT=json

# Week 3: Grounded RAG Configuration
RAG_POLICIES_DIR=./data/policies
RAG_EMBEDDING_DIM=384
RAG_DEFAULT_MODE=hybrid
RAG_MAX_CONTEXT_TOKENS=2000

# Week 4: Controlled AI Workflow, Security & HITL
JWT_SECRET=super-secret-development-jwt-signing-key-change-in-production
JWT_ALGORITHM=HS256
JWT_EXPIRATION_HOURS=8
APPROVAL_TTL_SECONDS=600
WORKFLOW_TIMEOUT_MS=10000
TOOL_TIMEOUT_MS=5000
IDEMPOTENCY_CACHE_TTL_SECONDS=86400
